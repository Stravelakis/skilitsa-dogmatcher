---
import DocsLayout from '../layouts/DocsLayout.astro';
import VernacularPanels from '../components/VernacularPanels.astro';
import FeatureCards from '../components/FeatureCards.astro';
import LevelPicker from '../components/LevelPicker.astro';
import Playground from '../components/Playground.astro';
import ReviewStamp from '../components/ReviewStamp.astro';
import Glossary from '../components/Glossary.astro';
import { siteConfig } from '../../site.config.ts';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

import { Content as Dev, frontmatter as devFm } from '../docs/dev.md';
import { Content as Plain, frontmatter as plainFm } from '../docs/plain.md';
import { Content as Eli5, frontmatter as eli5Fm } from '../docs/eli5.md';

// Read from the plugin itself, so the version shown cannot go stale.
const coreHeader = readFileSync(resolve(process.cwd(), '..', 'plugins', 'skilitsa-core', 'skilitsa-core.php'), 'utf8');
const version = (coreHeader.match(/^\s*\*\s*Version:\s*(\S+)/m) || [])[1] ?? '';

// One source: GUIDE.md / INSTALL.md copied in by scripts/sync-docs.mjs.
const sources = import.meta.glob<{ Content: any }>('../docs/source/*.md', { eager: true });
const guide = sources['../docs/source/guide.md'];
const install = sources['../docs/source/install.md'];

const features = [
  { icon: '🐕', title: 'Matches breeds to people', text: 'Visitors answer questions on a 1 to 5 scale and see a podium of the three best-matching breeds, each with a plain reason.' },
  { icon: '📊', title: 'Your data, in a Google Sheet', text: 'Traits, questions, breeds and texts live in a sheet. The Import screen shows what would change before anything is written.' },
  { icon: '🔗', title: 'Shareable results', text: 'Each result has its own link, /match/<token>/. Opening it shows the result as it was first computed.' },
  { icon: '🚫', title: 'Dealbreakers', text: 'A visitor can mark an answer as a must-have. Breeds that miss it badly are left out and the missing trait is named.' },
  { icon: '♿', title: 'Built for accessibility', text: 'Real radio buttons in fieldsets, a progress bar that screen readers can read, explanations that open from the keyboard, reduced motion respected.' },
  { icon: '🤖', title: 'Optional AI drafts', text: 'Admin-only and off until you configure it. A task can only produce a draft that a person approves. No generated word reaches a visitor on its own.' },
];
---
<DocsLayout title="Overview" home>
  <section class="frame hero reveal" id="top">
    <span class="label">Docs{version && ` · v${version}`}</span>
    <h1 class="hero-title">{siteConfig.projectName}</h1>
    <p class="hero-sub">{siteConfig.description}</p>
    <div class="btns">
      {siteConfig.heroLinks.map((l) => (
        <a class:list={['btn', { primary: l.primary }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="pills">
      {siteConfig.heroPills.map((t) => (
        <span class="pill"><i></i>{t}</span>
      ))}
    </div>
  </section>

  <LevelPicker />

  <FeatureCards features={features} title="What it does" />

  <section class="doc-body reveal" id="docs" aria-label="Documentation" data-glossary>
    <VernacularPanels>
      <Fragment slot="dev"><ReviewStamp {...devFm} /><Dev /></Fragment>
      <Fragment slot="plain"><ReviewStamp {...plainFm} /><Plain /></Fragment>
      <Fragment slot="eli5"><ReviewStamp {...eli5Fm} /><Eli5 /></Fragment>
    </VernacularPanels>
  </section>

  {/* No "reveal" on Install and Guide: it waits for part of a section to be on screen, which a long section never reaches. */}
  {install && (
    <section class="doc-body doc-source" id="install" aria-label="Install" data-glossary>
      <install.Content />
    </section>
  )}
  {guide && (
    <section class="doc-body doc-source" id="guide" aria-label="Guide" data-glossary>
      <guide.Content />
    </section>
  )}

  {siteConfig.playground.enabled && <Playground />}
  <Glossary />
</DocsLayout>
